# Copy to .env (which is gitignored) and fill in. Used by npm run deploy.
# Never prefix these with VITE_, or Vite would bundle them into the site.

# Your DreamHost SSH user and server name, both shown in the DreamHost panel where you manage SFTP/SSH users
DEPLOY_USER=your-shell-user
DEPLOY_HOST=iad1-shared-xx-xx.dreamhost.com

# The folder the domain serves from, usually the domain name in your home folder
DEPLOY_PATH=/home/your-shell-user/waltercoots.com
